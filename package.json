{
  "name": "dsh-llm-api-perf-workbench",
  "version": "1.3.2",
  "type": "module",
  "description": "大模型 API 服务质量检测工作台：TTFT、TPOT、RPS、输出 tok/s 与 tok/min、并发曲线、P99 与 SLO 边界（本地压测，不上传数据）",
  "author": "caisiyang123",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/caisiyang123/llm-api-perf-workbench"
  },
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "pack": "node build.mjs && pnpm pack",
    "test:browser": "node browser-tests/mode-switch-repro.mjs"
  },
  "keywords": [
    "dsh-workbench",
    "llm",
    "api",
    "benchmark",
    "performance",
    "ttft",
    "slo"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5",
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.3.0-0"
  }
}
